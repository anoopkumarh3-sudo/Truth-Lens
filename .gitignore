**/env/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Node.js & Frontend
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.npm/
*.local

# Model Weights, Checkpoints & Caches
models/
models_cache/
**/models_cache/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
.cache/
**/.cache/

# User Uploaded Media & Temporary Test Files
uploads/
**/uploads/
data/uploads/
data/processed/
*.mp4
*.wav
*.avi
*.mov
*.mp3
*.webm
*.flac
*.ogg
test_sample.*
**/test_sample.*

